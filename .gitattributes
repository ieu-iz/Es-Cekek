# Normalize line endings: keep LF in the working tree for Godot resources so
# .tscn / .tres / .godot parsing stays stable across platforms.
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Windows batch scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
